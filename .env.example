AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_MODEL_ROUNDTRIPS=6
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_CONSECUTIVE_TOOL_ERRORS=1
